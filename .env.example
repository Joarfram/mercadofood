# Obrigatórias: Configurações > API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon

# URL pública do MercadoFood, sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcionais: integração de notificações por WhatsApp.
# Nunca use credenciais reais neste arquivo.
WHATSAPP_WEBHOOK_URL=https://seu-provedor.example/webhook
WHATSAPP_WEBHOOK_TOKEN=seu-token-do-webhook

# WhatsApp Cloud API / Embedded Signup da Meta.
# Os valores privados nunca devem usar NEXT_PUBLIC_.
NEXT_PUBLIC_META_APP_ID=id-publico-do-aplicativo-meta
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=id-publico-da-configuracao-embedded-signup
META_APP_SECRET=segredo-privado-do-aplicativo-meta
META_GRAPH_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=token-aleatorio-para-validar-o-webhook
WHATSAPP_TOKEN_ENCRYPTION_KEY=segredo-aleatorio-com-pelo-menos-32-caracteres
SUPABASE_SERVICE_ROLE_KEY=chave-privada-do-supabase-apenas-no-servidor

# Mercado Pago Orders API / OAuth. Nunca use NEXT_PUBLIC_ para estes segredos.
MERCADO_PAGO_CLIENT_ID=id-da-aplicacao
MERCADO_PAGO_CLIENT_SECRET=segredo-da-aplicacao
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=chave-publica-da-aplicacao
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://www.meumercadofood.com/integracoes/mercadopago/oauth/callback
MERCADO_PAGO_WEBHOOK_SECRET=segredo-do-webhook
MERCADO_PAGO_TOKEN_ENCRYPTION_KEY=chave-base64-de-32-bytes
MERCADO_PAGO_ENVIRONMENT=test

# Opcional: leitura de cardápio por foto. A chave é privada e nunca recebe NEXT_PUBLIC_.
OPENAI_API_KEY=sua-chave-privada-openai
OPENAI_MENU_IMPORT_MODEL=gpt-5.6-luna
